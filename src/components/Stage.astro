---
// The stage: valance across the top, drapes on both sides, sweeping spotlights,
// and (home page only) a curtain that parts on the first visit of a session.
interface Props {
  opening?: boolean;
}
const { opening = true } = Astro.props;
---

<section class:list={['stage', { compact: !opening }]}>
  {
    opening && (
      <Fragment>
        <script is:inline>
          // Only run the curtain opening once per browser session.
          try {
            if (sessionStorage.getItem('rz-curtain')) document.documentElement.classList.add('curtain-seen');
            else sessionStorage.setItem('rz-curtain', '1');
          } catch (e) {}
        </script>
        <div class="opening" aria-hidden="true">
          <div class="half left" />
          <div class="half right" />
        </div>
      </Fragment>
    )
  }

  <svg width="0" height="0" class="defs" aria-hidden="true">
    <defs>
      <linearGradient id="pleat" x1="0" x2="1">
        <stop offset="0" stop-color="#3a0a0e" />
        <stop offset="0.35" stop-color="#6b1a1f" />
        <stop offset="0.55" stop-color="#a8333a" />
        <stop offset="0.75" stop-color="#6b1a1f" />
        <stop offset="1" stop-color="#3a0a0e" />
      </linearGradient>
      <pattern id="pleats" width="9" height="10" patternUnits="userSpaceOnUse">
        <rect width="9" height="10" fill="url(#pleat)" />
      </pattern>
      <linearGradient id="drape-shade" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#000" stop-opacity="0.15" />
        <stop offset="0.6" stop-color="#000" stop-opacity="0" />
        <stop offset="1" stop-color="#000" stop-opacity="0.55" />
      </linearGradient>
    </defs>
  </svg>

  {
    ['left', 'right'].map((side) => (
      <svg class:list={['drape', side]} viewBox="0 0 100 400" preserveAspectRatio="none" aria-hidden="true">
        <path
          d="M0,0 H100 C92,70 52,160 34,215 C28,236 30,246 36,258 C52,300 68,360 72,400 H0 Z"
          fill="url(#pleats)"
        />
        <path
          d="M0,0 H100 C92,70 52,160 34,215 C28,236 30,246 36,258 C52,300 68,360 72,400 H0 Z"
          fill="url(#drape-shade)"
        />
        <path
          d="M100,0 C92,70 52,160 34,215 C28,236 30,246 36,258 C52,300 68,360 72,400"
          fill="none"
          stroke="#c9a24a"
          stroke-width="2"
          vector-effect="non-scaling-stroke"
        />
        <path d="M2,232 C14,226 26,226 38,234" fill="none" stroke="#e8c36a" stroke-width="5" vector-effect="non-scaling-stroke" stroke-linecap="round" />
      </svg>
    ))
  }

  <div class="valance" aria-hidden="true"></div>
  <div class="beam one" aria-hidden="true"></div>
  <div class="beam two" aria-hidden="true"></div>

  <div class="stage-content">
    <slot />
  </div>
</section>


<style>
  .stage {
    position: relative;
    overflow: hidden;
    padding-top: 92px;
    margin-top: -1px;
  }
  .defs { position: absolute; }
  .stage.compact { padding-top: 84px; }

  .valance { position: absolute; top: 0; left: 0; right: 0; z-index: 3; }

  .drape {
    position: absolute;
    top: 0;
    bottom: 0;
    width: clamp(70px, 13vw, 190px);
    height: 100%;
    z-index: 2;
    filter: drop-shadow(8px 0 18px rgba(0, 0, 0, 0.6));
  }
  .drape.left { left: 0; }
  .drape.right { right: 0; transform: scaleX(-1); }

  .stage-content { position: relative; z-index: 1; }

  /* spotlights rising from the floor, slowly sweeping */
  .beam {
    position: absolute;
    bottom: -10%;
    width: 46vw;
    height: 130%;
    z-index: 0;
    pointer-events: none;
    clip-path: polygon(47% 100%, 53% 100%, 100% 0, 0 0);
    background: linear-gradient(to top, rgba(255, 228, 160, 0.22), rgba(255, 228, 160, 0.06) 55%, transparent 85%);
    filter: blur(6px);
    mix-blend-mode: screen;
    transform-origin: 50% 100%;
  }
  .beam.one { left: 0; animation: sweep-a 11s ease-in-out infinite alternate; }
  .beam.two { right: 0; animation: sweep-b 13s ease-in-out infinite alternate; }
  @keyframes sweep-a { from { transform: rotate(18deg); } to { transform: rotate(-6deg); } }
  @keyframes sweep-b { from { transform: rotate(-18deg); } to { transform: rotate(5deg); } }

  /* the opening curtain */
  .opening {
    position: fixed;
    inset: 0;
    z-index: 90;
    pointer-events: none;
    animation: opening-done 2.2s forwards;
  }
  .half {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 50.5%;
    background: linear-gradient(rgba(0, 0, 0, 0.1), transparent 50%, rgba(0, 0, 0, 0.5)), var(--pleats);
    animation: 1.5s cubic-bezier(0.7, 0, 0.25, 1) 0.45s forwards;
  }
  .half.left { left: 0; animation-name: part-left; box-shadow: 12px 0 30px rgba(0, 0, 0, 0.6); }
  .half.right { right: 0; animation-name: part-right; box-shadow: -12px 0 30px rgba(0, 0, 0, 0.6); }
  @keyframes part-left { to { transform: translateX(-102%); } }
  @keyframes part-right { to { transform: translateX(102%); } }
  @keyframes opening-done { to { visibility: hidden; } }
  :global(.curtain-seen) .opening { display: none; }

  @media (prefers-reduced-motion: reduce) {
    .opening { display: none; }
  }
  @media (max-width: 720px) {
    .drape { width: 34px; }
    .valance { height: 60px; }
    .stage { padding-top: 70px; }
  }
</style>
