---
// Clickable callouts on the turret CAD render. Positions are % of the image.
const parts = [
  {
    x: 62, y: 9,
    name: 'Launcher wheel',
    text: 'A spoked wheel spun up by the DC motor. The ball is fed against it and flung out — the faster the wheel, the farther the shot.',
  },
  {
    x: 55, y: 43,
    name: 'The projectile',
    text: 'A small ball sits in the feed path, ready to be pushed into the spinning wheel.',
  },
  {
    x: 35, y: 57,
    name: 'Stepper gearing',
    text: 'Stepper motors drive the aiming through small spur gears. Steppers move in exact steps, so the code always knows which way the turret is pointing.',
  },
  {
    x: 41, y: 87,
    name: 'Ring gear base',
    text: 'The whole launcher sits on one big ring gear. A small gear walking around it turns the entire turret — lots of teeth means fine, precise aim.',
  },
];
---

<figure class="exhibit cad" data-cad>
  <div class="exhibit-head">
    <span class="eyebrow">▶ Interactive · My CAD in Onshape</span>
    <span class="hint">Tap a number to explore the build.</span>
  </div>

  <div class="stage">
    <img src="/media/turret/cad.jpg" alt="CAD assembly of the turret: ring gear base, stepper gearing, ball feed and launcher wheel" />
    {
      parts.map((p, i) => (
        <button
          class="spot"
          style={`left:${p.x}%;top:${p.y}%`}
          data-i={i}
          aria-pressed={i === 0 ? 'true' : 'false'}
          aria-label={`${i + 1}: ${p.name}`}
        >
          {i + 1}
        </button>
      ))
    }
  </div>

  <div class="info" aria-live="polite">
    {
      parts.map((p, i) => (
        <div class="part" data-i={i} hidden={i !== 0}>
          <span class="num display">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <h3 class="display">{p.name}</h3>
            <p>{p.text}</p>
          </div>
        </div>
      ))
    }
  </div>
  <figcaption class="exhibit-note">
    10 sub-assemblies — gears, motor mounts, the Pi holder and the sensor enclosure — mated into one model.
  </figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('[data-cad]').forEach((root) => {
    const spots = root.querySelectorAll<HTMLButtonElement>('.spot');
    const parts = root.querySelectorAll<HTMLElement>('.part');
    spots.forEach((spot) =>
      spot.addEventListener('click', () => {
        spots.forEach((s) => s.setAttribute('aria-pressed', String(s === spot)));
        parts.forEach((p) => (p.hidden = p.dataset.i !== spot.dataset.i));
      }),
    );
  });
</script>

<style>
  .stage { position: relative; border-radius: 3px; overflow: hidden; }
  .stage img { width: 100%; }
  .spot {
    position: absolute;
    transform: translate(-50%, -50%);
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    border: 2px solid #1a1208;
    background: var(--bulb);
    color: #1a1208;
    font-family: var(--mono);
    font-weight: 500;
    font-size: 0.85rem;
    cursor: pointer;
    box-shadow: 0 0 0 0 rgba(246, 199, 91, 0.7);
    animation: ping 2.2s infinite;
    transition: transform 0.15s, background 0.15s;
  }
  .spot:hover { transform: translate(-50%, -50%) scale(1.12); }
  .spot[aria-pressed='true'] { background: var(--ticket); color: #fff4e6; animation: none; box-shadow: 0 0 0 5px rgba(212, 64, 46, 0.35); }
  @keyframes ping {
    70% { box-shadow: 0 0 0 12px rgba(246, 199, 91, 0); }
    100% { box-shadow: 0 0 0 0 rgba(246, 199, 91, 0); }
  }
  .info { margin-top: 1rem; min-height: 6.5rem; }
  .part { display: flex; gap: 1rem; align-items: flex-start; }
  .part[hidden] { display: none; }
  .num { font-size: 2.6rem; color: var(--ticket); line-height: 0.9; }
  .part h3 { margin: 0 0 0.3rem; font-size: 1.5rem; }
  .part p { margin: 0; color: var(--on-house-soft); font-size: 1rem; line-height: 1.5; }
</style>
