---
// Old film-leader countdown (3, 2, 1) laid over the screen. It plays once when
// the screen scrolls into view, then fades away. Clicks pass straight through.
---

<div class="leader" aria-hidden="true" data-leader>
  <svg viewBox="0 0 200 200" class="rings">
    <circle cx="100" cy="100" r="88" />
    <circle cx="100" cy="100" r="70" />
    <line x1="0" y1="100" x2="200" y2="100" />
    <line x1="100" y1="0" x2="100" y2="200" />
  </svg>
  <div class="sweep"></div>
  <span class="count display">3</span>
  <div class="scratches"></div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-leader]').forEach((el) => {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return el.remove();
    const count = el.querySelector<HTMLElement>('.count')!;
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        el.classList.add('rolling');
        let n = 3;
        const tick = window.setInterval(() => {
          n -= 1;
          if (n > 0) {
            count.textContent = String(n);
            el.classList.remove('rolling');
            void el.offsetWidth; // restart the sweep animation
            el.classList.add('rolling');
          } else {
            window.clearInterval(tick);
            el.classList.add('done');
            window.setTimeout(() => el.remove(), 700);
          }
        }, 900);
      },
      { threshold: 0.6 },
    );
    io.observe(el);
  });
</script>

<style>
  @property --sweep {
    syntax: '<angle>';
    inherits: false;
    initial-value: 0deg;
  }
  .leader {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: grid;
    place-items: center;
    overflow: hidden;
    pointer-events: none;
    background: radial-gradient(circle, #d8cfbf 0%, #b9ae9a 70%, #8f8574 100%);
    animation: flicker 0.18s steps(2) infinite;
    transition: opacity 0.6s;
  }
  .leader.done { opacity: 0; }
  .rings, .sweep, .count, .scratches { grid-area: 1 / 1; }
  .rings { width: min(70%, 60vh); height: auto; fill: none; stroke: #2a2420; stroke-width: 2.5; }
  .sweep {
    width: min(70%, 60vh);
    aspect-ratio: 1;
    border-radius: 50%;
    background: conic-gradient(rgba(42, 36, 32, 0.4) var(--sweep), transparent var(--sweep));
  }
  .rolling .sweep { animation: sweep 0.9s linear; }
  @keyframes sweep { from { --sweep: 0deg; } to { --sweep: 360deg; } }
  .count { font-size: clamp(5rem, 22vw, 11rem); color: #1f1a17; font-weight: 900; line-height: 1; }
  .scratches {
    width: 100%;
    height: 100%;
    background:
      linear-gradient(90deg, transparent 23%, rgba(0, 0, 0, 0.25) 23.2%, transparent 23.5%),
      linear-gradient(90deg, transparent 71%, rgba(255, 255, 255, 0.4) 71.15%, transparent 71.3%);
    animation: scratch 0.3s steps(3) infinite;
  }
  @keyframes flicker { 50% { filter: brightness(0.92); } }
  @keyframes scratch { 33% { transform: translateX(3%); } 66% { transform: translateX(-4%); } }
</style>
