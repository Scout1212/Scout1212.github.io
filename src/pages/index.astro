---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Marquee from '../components/Marquee.astro';
import Stage from '../components/Stage.astro';
import FilmStrip from '../components/FilmStrip.astro';
import VelvetRope from '../components/VelvetRope.astro';
import { site } from '../site';

const features = (await getCollection('features')).sort((a, b) => a.data.reel - b.data.reel);
const pad = (n: number) => String(n).padStart(2, '0');

const stubs = [
  { label: 'Email', value: site.links.email, href: `mailto:${site.links.email}` },
  { label: `GitHub · @${site.links.github.split('/').filter(Boolean).pop()}`, value: site.links.github, href: site.links.github },
  { label: 'LinkedIn', value: site.links.linkedin, href: site.links.linkedin },
  { label: 'Résumé', value: site.links.resume, href: site.links.resume },
].filter((s) => s.value);
---

<Base>
  <main>
    <Stage>
      <div class="wrap hero">
        <Marquee />
        <p class="intro">{site.intro}</p>
      </div>
    </Stage>

    <FilmStrip words={['★ Now showing', site.name, site.season, 'Robots · Circuits · Code']} />

    <section id="program" class="wrap program-section">
      <div class="paper program">
        <header class="program-head">
          <p class="eyebrow ornament">{site.season} · {features.length} features</p>
          <h2 class="display">Tonight's Program</h2>
        </header>

        <ol class="features">
          {
            features.map((f) => (
              <li>
                <a class="feature ticket" href={`/features/${f.id}/`}>
                  <span class="reel eyebrow">
                    Reel
                    <b class="display">{pad(f.data.reel)}</b>
                  </span>
                  <span class="body">
                    <span class="meta eyebrow">
                      <span class:list={['chip', { live: f.data.status === 'In production' }]}>{f.data.status}</span>
                      <span>{f.data.released}</span>
                    </span>
                    <span class="title display">{f.data.title}</span>
                    <span class="logline">{f.data.logline}</span>
                    <span class="genres eyebrow">{f.data.genres.join(' · ')}</span>
                    <span class="admit eyebrow" aria-hidden="true">See the feature →</span>
                  </span>
                  <span class="tear">
                    <span class:list={['poster', { sprite: f.data.poster.src.endsWith('.gif') }]}>
                      <img src={f.data.poster.src} alt={f.data.poster.alt} loading="lazy" />
                    </span>
                    <span class="admit-one eyebrow" aria-hidden="true">
                      Admit one <i>No. {String(f.data.reel * 1024 + 7).padStart(6, '0')}</i>
                    </span>
                  </span>
                </a>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <FilmStrip words={["Director's notes", '★', 'Season one', '★', 'Behind the scenes']} tilt="right" />

    <section id="notes" class="wrap notes">
      <p class="eyebrow label">Director's notes</p>
      <div class="notes-body">
        <p class="lede">
          To me, computer science is problem solving at its core. Robotics lets me take that problem solving off the
          screen and into the real world, where I can build something to solve almost any problem I choose.
        </p>
        <p>
          I'm studying computer science at Binghamton University and plan to double major in electrical engineering.
          My favorite part of any project is the beginning: picturing the whole thing, then researching and learning
          whatever it takes to build it.
        </p>
        <p>
          I'm working toward embedded systems and robotics, and I'm looking for research and internship opportunities
          where I can keep building and learn from people who know more than I do.
        </p>
      </div>
    </section>

    <div class="wrap rope-wrap"><VelvetRope /></div>

    <section id="box-office" class="wrap box-office">
      <p class="eyebrow label">Box office</p>
      <div class="stubs">
        {
          stubs.length > 0 ? (
            stubs.map((s) => (
              <a class="stub" href={s.href} {...(s.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}>
                <span class="eyebrow">{s.label}</span>
                <span class="display">Admit one</span>
              </a>
            ))
          ) : (
            <div class="stub">
              <span class="eyebrow">Opening soon</span>
              <span class="display">Contact links coming</span>
            </div>
          )
        }
      </div>
    </section>
  </main>
</Base>

<style>
  .hero {
    padding-top: clamp(0.5rem, 2vw, 1.5rem);
    padding-left: max(var(--gutter), calc(clamp(70px, 13vw, 190px) * 0.8));
    padding-right: max(var(--gutter), calc(clamp(70px, 13vw, 190px) * 0.8));
  }
  @media (max-width: 720px) {
    .hero { padding-left: 30px; padding-right: 30px; }
  }
  .intro {
    max-width: 38ch;
    margin: clamp(2rem, 5vw, 3.5rem) auto clamp(3rem, 7vw, 5rem);
    text-align: center;
    font-size: clamp(1.25rem, 2.6vw, 1.6rem);
    font-style: italic;
    line-height: 1.45;
    color: var(--on-house);
  }

  /* ---------- program ---------- */
  .program-section { padding-top: clamp(3rem, 7vw, 5rem); padding-bottom: clamp(3rem, 7vw, 5rem); }
  .rope-wrap { padding-top: clamp(3rem, 7vw, 5rem); margin-bottom: -2rem; }
  .program { padding: clamp(1.75rem, 5vw, 3.5rem) clamp(1rem, 5vw, 4rem); }
  .program-head { text-align: center; margin-bottom: 1.5rem; }
  .program-head h2 { font-size: clamp(2.6rem, 8vw, 4.75rem); margin: 0.6rem 0 0; }

  .features { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.4rem; }

  /* each feature is an admission ticket: body on the left, tear-off stub on the right */
  .ticket {
    --notch-bg: var(--paper);
    position: relative;
    display: grid;
    grid-template-columns: 4.5rem 1fr 15.5rem;
    text-decoration: none;
    color: inherit;
    background:
      radial-gradient(circle at 100% 0, rgba(201, 162, 74, 0.12), transparent 40%),
      #f8f0e1;
    border-radius: 6px;
    box-shadow: 0 1px 0 var(--rule), 0 14px 26px -18px rgba(40, 20, 10, 0.55);
    outline: 1px dashed var(--rule);
    outline-offset: -8px;
    transition: transform 0.25s, box-shadow 0.25s;
  }
  .features li:nth-child(even) .ticket { background: radial-gradient(circle at 100% 0, rgba(212, 64, 46, 0.08), transparent 40%), #f8f0e1; }
  .ticket:hover { transform: translateY(-4px) rotate(-0.4deg); box-shadow: 0 1px 0 var(--rule), 0 24px 34px -18px rgba(40, 20, 10, 0.6); }

  .reel {
    display: flex;
    flex-direction: column;
    justify-content: center;
    color: var(--ink-soft);
    font-size: 0.62rem;
    text-align: center;
    border-right: 1px solid var(--rule);
    margin: 1.5rem 0;
  }
  .reel b { display: block; font-size: 2.8rem; color: var(--ink); letter-spacing: 0; margin-top: 0.2rem; }
  .body { display: flex; flex-direction: column; gap: 0.45rem; padding: 1.9rem 1.75rem; }
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; font-size: 0.68rem; color: var(--ink-soft); }
  .title { font-size: clamp(2rem, 4.5vw, 3rem); transition: color 0.2s; }
  .logline { font-size: 1.1rem; color: var(--ink); max-width: 52ch; }
  .genres { font-size: 0.65rem; color: var(--ink-soft); letter-spacing: 0.14em; }
  .admit { font-size: 0.68rem; color: var(--ticket); margin-top: 0.4rem; transition: transform 0.2s; }
  .ticket:hover .title { color: var(--ticket); }
  .ticket:hover .admit { transform: translateX(6px); }

  /* the stub, separated by a perforation with a notch punched at each end */
  .tear {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 0.6rem;
    padding: 1.25rem 1rem 1.25rem 1.25rem;
    border-left: 2px dashed var(--rule);
  }
  .tear::before, .tear::after {
    content: '';
    position: absolute;
    left: -11px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--notch-bg);
  }
  .tear::before { top: -10px; box-shadow: inset 0 -2px 2px rgba(40, 20, 10, 0.12); }
  .tear::after { bottom: -10px; box-shadow: inset 0 2px 2px rgba(40, 20, 10, 0.12); }
  .admit-one {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-size: 0.62rem;
    letter-spacing: 0.3em;
    color: var(--ticket);
    font-weight: 500;
  }
  .admit-one i { font-style: normal; color: var(--ink-soft); margin-top: 0.8em; display: inline-block; }

  .poster {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 3px;
    background: var(--house);
    box-shadow: 0 0 0 1px var(--rule);
  }
  .poster img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s; }
  .ticket:hover .poster img { transform: scale(1.05); }
  .poster.sprite { background: radial-gradient(circle at 50% 60%, #3b2a26, var(--house) 70%); }
  .poster.sprite img { object-fit: contain; padding: 12%; image-rendering: pixelated; }

  @media (max-width: 760px) {
    .ticket { grid-template-columns: 3.25rem 1fr; }
    .reel b { font-size: 2rem; }
    .body { padding: 1.4rem 1.1rem 1.4rem 1rem; }
    .tear {
      grid-column: 1 / -1;
      grid-row: 1;
      border-left: none;
      border-bottom: 2px dashed var(--rule);
      padding: 1rem;
    }
    .tear::before { top: auto; bottom: -11px; left: -10px; }
    .tear::after { bottom: -11px; left: auto; right: -10px; }
  }

  /* ---------- director's notes & box office ---------- */
  .notes, .box-office {
    display: grid;
    grid-template-columns: 13rem 1fr;
    gap: 1rem 2rem;
    padding-top: clamp(3.5rem, 8vw, 6rem);
  }
  .label { color: var(--bulb); margin: 0.5rem 0 0; }
  .notes-body { max-width: 60ch; color: var(--on-house-soft); }
  .notes-body p { margin: 0 0 1.1rem; }
  .lede { font-size: clamp(1.4rem, 3vw, 1.9rem); line-height: 1.3; color: var(--on-house); }

  .stubs { display: flex; flex-wrap: wrap; gap: 1rem; }
  .stub {
    --notch: 10px;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 12rem;
    padding: 1rem 1.5rem 1rem 1.75rem;
    background: var(--ticket);
    color: #fff4e6;
    text-decoration: none;
    border-left: 2px dashed rgba(255, 244, 230, 0.5);
    mask: radial-gradient(circle var(--notch) at 0 50%, transparent 98%, #000) left / 51% 100% no-repeat,
      radial-gradient(circle var(--notch) at 100% 50%, transparent 98%, #000) right / 51% 100% no-repeat;
    transition: transform 0.2s;
  }
  a.stub:hover { transform: translateY(-3px) rotate(-1deg); }
  .stub .eyebrow { font-size: 0.65rem; opacity: 0.85; }
  .stub .display { font-size: 1.6rem; }

  @media (max-width: 720px) {
    .notes, .box-office { grid-template-columns: 1fr; }
  }
</style>
